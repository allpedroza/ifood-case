{
  "datasets": [
    {
      "name": "latest_run",
      "displayName": "Última execução",
      "queryLines": [
        "SELECT date_format(executed_at, 'yyyy-MM-dd HH:mm:ss') AS last_execution, evaluated_rules, ok_results, warn_results, fail_results FROM case_ifood.tlc_data_quality.dq_dashboard_run_summary QUALIFY ROW_NUMBER() OVER (ORDER BY executed_at DESC) = 1"
      ]
    },
    {
      "name": "table_success",
      "displayName": "Sucesso por tabela",
      "queryLines": [
        "SELECT\n",
        "  CASE layer\n",
        "    WHEN 'landing' THEN '1. landing'\n",
        "    WHEN 'bronze' THEN '2. bronze'\n",
        "    WHEN 'silver' THEN '3. silver'\n",
        "    WHEN 'gold' THEN '4. gold'\n",
        "    ELSE layer\n",
        "  END as layer,\n",
        "  table_name,\n",
        "  success_percentage\n",
        "FROM\n",
        "  case_ifood.tlc_data_quality.dq_dashboard_table_success\n",
        "WHERE\n",
        "  execution_id\n",
        "    = (\n",
        "      SELECT\n",
        "        execution_id\n",
        "      FROM\n",
        "        case_ifood.tlc_data_quality.dq_dashboard_run_summary\n",
        "      ORDER BY\n",
        "        executed_at DESC\n",
        "      LIMIT 1\n",
        "    )\n",
        "ORDER BY\n",
        "  CASE layer\n",
        "    WHEN 'landing' THEN 1\n",
        "    WHEN 'bronze' THEN 2\n",
        "    WHEN 'silver' THEN 3\n",
        "    WHEN 'gold' THEN 4\n",
        "  END"
      ]
    },
    {
      "name": "dimension_success",
      "displayName": "Sucesso por dimensão",
      "queryLines": [
        "SELECT layer, dimension, success_percentage FROM case_ifood.tlc_data_quality.dq_dashboard_dimension_success WHERE execution_id = (SELECT execution_id FROM case_ifood.tlc_data_quality.dq_dashboard_run_summary ORDER BY executed_at DESC LIMIT 1)"
      ]
    },
    {
      "name": "rule_matrix",
      "displayName": "Violações por regra e camada",
      "queryLines": [
        "SELECT layer, rule_name, violation_count, violation_percentage, status FROM case_ifood.tlc_data_quality.dq_dashboard_results WHERE execution_id = (SELECT execution_id FROM case_ifood.tlc_data_quality.dq_dashboard_run_summary ORDER BY executed_at DESC LIMIT 1)"
      ]
    },
    {
      "name": "success_history",
      "displayName": "Histórico de sucesso",
      "queryLines": [
        "SELECT execution_date, layer, success_percentage FROM case_ifood.tlc_data_quality.dq_dashboard_table_success ORDER BY execution_date, layer"
      ]
    },
    {
      "name": "rules_by_dimension",
      "displayName": "Regras por dimensão",
      "queryLines": [
        "SELECT\n",
        "  dimension,\n",
        "  COUNT(DISTINCT rule_name) as rule_count\n",
        "FROM\n",
        "  case_ifood.tlc_data_quality.dq_dashboard_results\n",
        "WHERE\n",
        "  execution_id\n",
        "    = (\n",
        "      SELECT\n",
        "        execution_id\n",
        "      FROM\n",
        "        case_ifood.tlc_data_quality.dq_dashboard_run_summary\n",
        "      ORDER BY\n",
        "        executed_at DESC\n",
        "      LIMIT 1\n",
        "    )\n",
        "GROUP BY\n",
        "  dimension\n",
        "ORDER BY\n",
        "  rule_count DESC"
      ]
    },
    {
      "name": "rules_analysis",
      "displayName": "Análise de regras cadastradas",
      "queryLines": [
        "SELECT\n",
        "  dimension,\n",
        "  rule_name,\n",
        "  rule_type,\n",
        "  table_name,\n",
        "  column_name\n",
        "FROM\n",
        "  case_ifood.tlc_data_quality.dq_dashboard_results\n",
        "WHERE\n",
        "  execution_id\n",
        "    = (\n",
        "      SELECT\n",
        "        execution_id\n",
        "      FROM\n",
        "        case_ifood.tlc_data_quality.dq_dashboard_run_summary\n",
        "      ORDER BY\n",
        "        executed_at DESC\n",
        "      LIMIT 1\n",
        "    )\n",
        "ORDER BY\n",
        "  dimension,\n",
        "  rule_name"
      ]
    },
    {
      "name": "unique_rules",
      "displayName": "Regras únicas cadastradas",
      "queryLines": [
        "SELECT DISTINCT\n",
        "  rule_name,\n",
        "  dimension,\n",
        "  table_name,\n",
        "  description\n",
        "FROM\n",
        "  case_ifood.tlc_data_quality.dq_dashboard_results\n",
        "WHERE\n",
        "  execution_id\n",
        "    = (\n",
        "      SELECT\n",
        "        execution_id\n",
        "      FROM\n",
        "        case_ifood.tlc_data_quality.dq_dashboard_run_summary\n",
        "      ORDER BY\n",
        "        executed_at DESC\n",
        "      LIMIT 1\n",
        "    )\n",
        "ORDER BY\n",
        "  dimension,\n",
        "  rule_name"
      ]
    },
    {
      "name": "rule_catalog_count",
      "displayName": "Contagem de regras no catálogo",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT rule_id) as unique_rules_count\n",
        "FROM\n",
        "  case_ifood.tlc_data_quality.dq_rule_catalog\n",
        "WHERE\n",
        "  active = true"
      ]
    }
  ],
